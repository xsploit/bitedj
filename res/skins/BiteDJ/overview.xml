<Template>
  <WidgetGroup>
    <ObjectName>Overview</ObjectName>
    <Layout>vertical</Layout>
    <Size>0me,0me</Size>
    <Children>
      <WidgetGroup>
        <ObjectName>Waveforms_Container</ObjectName>
        <Layout>horizontal</Layout>
        <Children>
          <WidgetGroup>
            <ObjectName>PlayerSidebarHandle</ObjectName>
            <Layout>vertical</Layout>
            <Size>44f,0me</Size>
            <Children>
              <WidgetGroup>
                <Size>0me,0me</Size>
              </WidgetGroup>
              <PushButton>
                <ObjectName>PlayerToggleLeft</ObjectName>
                <Size>44f,88f</Size>
                <NumberStates>2</NumberStates>
                <State>
                  <Number>0</Number>
                  <Text>&#8250;</Text>
                </State>
                <State>
                  <Number>1</Number>
                  <Text>&#8249;</Text>
                </State>
                <Connection>
                  <ConfigKey>[Skin],player_left_rail</ConfigKey>
                  <EmitOnDownPress>true</EmitOnDownPress>
                </Connection>
              </PushButton>
              <WidgetGroup>
                <Size>0me,0me</Size>
              </WidgetGroup>
            </Children>
          </WidgetGroup>
          <Template src="skin:waveforms.xml" />
          <WidgetGroup>
            <ObjectName>PlayerSidebarHandle</ObjectName>
            <Layout>vertical</Layout>
            <Size>44f,0me</Size>
            <Children>
              <WidgetGroup>
                <Size>0me,0me</Size>
              </WidgetGroup>
              <PushButton>
                <ObjectName>PlayerToggleRight</ObjectName>
                <Size>44f,88f</Size>
                <NumberStates>2</NumberStates>
                <State>
                  <Number>0</Number>
                  <Text>&#8249;</Text>
                </State>
                <State>
                  <Number>1</Number>
                  <Text>&#8250;</Text>
                </State>
                <Connection>
                  <ConfigKey>[Skin],player_right_tools</ConfigKey>
                  <EmitOnDownPress>true</EmitOnDownPress>
                </Connection>
              </PushButton>
              <WidgetGroup>
                <Size>0me,0me</Size>
              </WidgetGroup>
            </Children>
          </WidgetGroup>
          <Template src="skin:effects.xml" />
        </Children>
      </WidgetGroup>
      <Template src="skin:cuepanel.xml" />
    </Children>
    <Connection>
      <ConfigKey>[BiteDJ],main_view_style</ConfigKey>
      <BindProperty>highlight</BindProperty>
      <Transform>
        <IsEqual>3</IsEqual>
      </Transform>
    </Connection>
  </WidgetGroup>
</Template>