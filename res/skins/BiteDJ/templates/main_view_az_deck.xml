            <Size>0me,36f</Size>
            <NumberStates>2</NumberStates>
            <State>
              <Number>0</Number>
              <Text>MT</Text>
            </State>
            <State>
              <Number>1</Number>
              <Text>MT</Text>
            </State>
            <Connection>
              <ConfigKey>[Channel<Variable name="channel" />],keylock</ConfigKey>
              <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
            </Connection>
          </PushButton>
          <PushButton>
            <ObjectName>AzSync<Variable name="channel" />
            </ObjectName>
            <Size>0me,36f</Size>
            <NumberStates>2</NumberStates>
            <State>
              <Number>0</Number>
              <Text>SYNC</Text>
            </State>
            <State>
              <Number>1</Number>
              <Text>SYNC</Text>
            </State>
            <Connection>
              <ConfigKey>[Channel<Variable name="channel" />],sync_enabled</ConfigKey>
              <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup>
      <WidgetGroup>
        <ObjectName>AzTransport</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,42f</Size>
        <Children>
          <PushButton>
            <ObjectName>AzCue<Variable name="channel" />
            </ObjectName>
            <Size>0me,42f</Size>
            <NumberStates>2</NumberStates>
            <State>
              <Number>0</Number>
              <Text>CUE</Text>
            </State>
            <State>
              <Number>1</Number>
              <Text>CUE</Text>
            </State>
            <LeftClickIsPushButton>true</LeftClickIsPushButton>
            <Connection>
              <ConfigKey>[Channel<Variable name="channel" />],cue_default</ConfigKey>
              <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
            </Connection>
          </PushButton>
          <PushButton>
            <ObjectName>AzPlay<Variable name="channel" />
            </ObjectName>
            <Size>0me,42f</Size>
            <NumberStates>2</NumberStates>
            <State>
              <Number>0</Number>
              <Text>PLAY</Text>
            </State>
            <State>
              <Number>1</Number>
              <Text>PLAY</Text>
            </State>
            <Connection>
              <ConfigKey>[Channel<Variable name="channel" />],play</ConfigKey>
              <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup>
      <WidgetGroup>
        <ObjectName>AzRailSpacer</ObjectName>
        <Layout>vertical</Layout>
        <Size>0me,0me</Size>
        <Children />
      </WidgetGroup>
    </Children>
  </WidgetGroup>
</Template>