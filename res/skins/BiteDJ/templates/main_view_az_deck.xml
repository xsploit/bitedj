              <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
            </Connection>
            <Connection>
              <ConfigKey>[Channel<Variable name="channel" />],loop_enabled</ConfigKey>
              <BindProperty>highlight</BindProperty>
            </Connection>
            <Connection>
              <ConfigKey>[Channel<Variable name="channel" />],loop_enabled</ConfigKey>
              <BindProperty>visible</BindProperty>
            </Connection>
          </PushButton>
          <BeatSpinBox>
            <ObjectName>AzLoopSize<Variable name="channel" />
            </ObjectName>
            <Value>[Channel<Variable name="channel" />],beatloop_size</Value>
            <Size>0me,36f</Size>
          </BeatSpinBox>
        </Children>
