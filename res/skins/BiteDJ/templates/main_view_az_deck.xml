              <ConfigKey>[Channel<Variable name="channel" />],beatjump_forward</ConfigKey>
              <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup>
      <WidgetGroup>
        <ObjectName>AzLoop</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,36f</Size>
        <Children>
          <PushButton>
            <ObjectName>AzLoopToggle<Variable name="channel" />
            </ObjectName>
            <Size>58f,36f</Size>
            <NumberStates>2</NumberStates>
            <State>
              <Number>0</Number>
              <Text>LOOP</Text>
            </State>
            <State>
              <Number>1</Number>
              <Text>LOOP</Text>
            </State>
            <LeftClickIsPushButton>true</LeftClickIsPushButton>
            <Connection>
              <ConfigKey>[Channel<Variable name="channel" />],beatloop_activate</ConfigKey>
              <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
            </Connection>
            <Connection>
              <ConfigKey>[Channel<Variable name="channel" />],loop_enabled</ConfigKey>
              <BindProperty>highlight</BindProperty>
            </Connection>
            <Connection>
              <ConfigKey>[Channel<Variable name="channel" />],loop_enabled</ConfigKey>
              <BindProperty>visible</BindProperty>
              <Transform>
                <Not />
              </Transform>
            </Connection>
          </PushButton>
          <PushButton>
            <ObjectName>AzLoopExit<Variable name="channel" />
            </ObjectName>
            <Size>58f,36f</Size>
            <NumberStates>2</NumberStates>
