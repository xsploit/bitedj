<Template>
  <WidgetGroup>
    <ObjectName>AzRail</ObjectName>
    <Layout>vertical</Layout>
    <Size>126f,0me</Size>
    <Children>
      <Label>
        <ObjectName>AzRailDeck</ObjectName>
        <Text>DECK <Variable name="channel" />
        </Text>
        <Size>0me,26f</Size>
        <Connection>
          <ConfigKey>[Channel<Variable name="channel" />],play</ConfigKey>
          <BindProperty>highlight</BindProperty>
        </Connection>
      </Label>
      <WidgetGroup>
        <ObjectName>AzKeyRow</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,32f</Size>
        <Children>
          <Label>
            <ObjectName>AzCaption</ObjectName>
            <Text>KEY</Text>
            <Size>36f,0me</Size>
          </Label>
          <Key>
            <ObjectName>AzKey</ObjectName>
            <Channel>
              <Variable name="channel" />
            </Channel>
            <DisplayCents>false</DisplayCents>
            <Connection>
              <ConfigKey>[Channel<Variable name="channel" />],visual_key</ConfigKey>
            </Connection>
          </Key>
          <PushButton>
            <ObjectName>AzKeyTools<Variable name="channel" />
            </ObjectName>
            <Size>30f,32f</Size>
            <NumberStates>2</NumberStates>
            <State>
              <Number>0</Number>
              <Text>&#8250;</Text>
            </State>
            <State>
              <Number>1</Number>
              <Text>&#8250;</Text>
            </State>
            <LeftClickIsPushButton>true</LeftClickIsPushButton>
            <Connection>
              <ConfigKey>[FxPanel],key</ConfigKey>
              <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
            </Connection>
          </PushButton>
        </Children>
      </WidgetGroup>
      <Label>
        <ObjectName>AzCaption</ObjectName>
        <Text>BEAT JUMP</Text>
        <Size>0me,16f</Size>
      </Label>
      <WidgetGroup>
        <ObjectName>AzJump</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,36f</Size>
        <Children>
          <PushButton>
            <ObjectName>AzJumpBack<Variable name="channel" />
            </ObjectName>
            <Size>34f,36f</Size>
            <NumberStates>2</NumberStates>
            <State>
              <Number>0</Number>
              <Text>&#8249;</Text>
            </State>
            <State>
              <Number>1</Number>
              <Text>&#8249;</Text>
            </State>
            <LeftClickIsPushButton>true</LeftClickIsPushButton>
            <Connection>
              <ConfigKey>[Channel<Variable name="channel" />],beatjump_backward</ConfigKey>
              <EmitOnPressAndRelease>true</EmitOnPressAndRelease>
            </Connection>
          </PushButton>
          <BeatSpinBox>
            <ObjectName>AzJumpSize<Variable name="channel" />
            </ObjectName>
            <Size>0me,36f</Size>
            <Value>[Channel<Variable name="channel" />],beatjump_size</Value>
          </BeatSpinBox>
          <PushButton>
            <ObjectName>AzJumpForward<Variable name="channel" />
            </ObjectName>
            <Size>34f,36f</Size>
            <NumberStates>2</NumberStates>
            <State>
              <Number>0</Number>
              <Text>&#8250;</Text>
            </State>
            <State>
              <Number>1</Number>
              <Text>&#8250;</Text>
            </State>
            <LeftClickIsPushButton>true</LeftClickIsPushButton>
