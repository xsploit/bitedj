<!--
  The bottom row of the Overview: normally the two deck strips, and when the
  cue drawer is opened, the pads for one deck in their place.

  This is one WidgetStack whose page 0 *is* the deck strips, so "closed" is a
  page rather than a hidden widget. Tapping a deck's CUE chip writes that
  deck's trigger ([Skin],cue_deck1 / cue_deck2), which both selects the deck
  and opens the drawer in a single press; the drawer's X writes
  [Skin],cue_close to go back to page 0. That is the same select-only trigger
  pattern as the FX / KEY tabs, and it avoids needing a button that writes two
  controls at once.

  Closed costs nothing but the chips in the deck headers. The drawer only ever
  covers the deck strips, which are readouts — the waveforms, which are not,
  stay put. The legacy pages are sized 180max; AZ reserves 292px for its full cards. Thus
  the waveform row above does not resize when the drawer opens
  (WWidgetStack forwards its minimumSizeHint to the current page).

  [Skin],cue_bank selects which bank the pads address (0 hot, 1 memory) and is
  shared by both deck pages, so the bank survives switching decks. None of
  these controls are persisted: the drawer opens closed, on hot cues.
-->
<Template>
  <WidgetStack currentpage="[Skin],cue_panel">
    <ObjectName>CuePanel_Stack</ObjectName>
    <Size>0me,0min</Size>
    <Children>
      <WidgetGroup trigger="[Skin],cue_close">
        <Layout>vertical</Layout>
        <Size>0me,0min</Size>
        <Children>
          <WidgetGroup>
            <ObjectName>Decks</ObjectName>
            <Layout>horizontal</Layout>
            <Size>0me,180max</Size>
            <Children>
              <Template src="skin:deck.xml">
                <SetVariable name="channel">1</SetVariable>
              </Template>
              <Template src="skin:deck.xml">
                <SetVariable name="channel">2</SetVariable>
              </Template>
            </Children>
            <Connection>
              <ConfigKey>[BiteDJ],main_view_style</ConfigKey>
              <BindProperty>visible</BindProperty>
              <Transform>
                <IsEqual>3</IsEqual>
                <Not />
              </Transform>
            </Connection>
          </WidgetGroup>
          <WidgetGroup>
            <ObjectName>AzDecks</ObjectName>
            <Layout>horizontal</Layout>
            <Size>0me,0min</Size>
            <Children>
              <Template src="skin:templates/az_play_deck.xml">
                <SetVariable name="channel">1</SetVariable>
              </Template>
              <Template src="skin:templates/az_play_deck.xml">
                <SetVariable name="channel">2</SetVariable>
              </Template>
            </Children>
            <Connection>
              <ConfigKey>[BiteDJ],main_view_style</ConfigKey>
              <BindProperty>visible</BindProperty>
              <Transform>
                <IsEqual>3</IsEqual>
              </Transform>
            </Connection>
          </WidgetGroup>
        </Children>
      </WidgetGroup>
      <WidgetGroup trigger="[Skin],cue_deck1">
        <ObjectName>CuePanel</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,180max</Size>
        <Children>
          <Template src="skin:templates/cue_deck_page.xml">
            <SetVariable name="channel">1</SetVariable>
          </Template>
        </Children>
      </WidgetGroup>
      <WidgetGroup trigger="[Skin],cue_deck2">
        <ObjectName>CuePanel</ObjectName>
        <Layout>horizontal</Layout>
        <Size>0me,180max</Size>
        <Children>
          <Template src="skin:templates/cue_deck_page.xml">
            <SetVariable name="channel">2</SetVariable>
          </Template>
        </Children>
      </WidgetGroup>
    </Children>
    <Connection>
      <ConfigKey>[BiteDJ],main_view_style</ConfigKey>
      <BindProperty>highlight</BindProperty>
      <Transform>
        <IsEqual>3</IsEqual>
      </Transform>
    </Connection>
  </WidgetStack>
</Template>